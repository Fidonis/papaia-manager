# Environment for docker/docker-compose.yml.
# Copy this file to docker/.env and fill in real values.
# docker/.env is gitignored and MUST NOT be committed.

# --- OIDC (Keycloak) ---
# Browser-facing authorization endpoint (same variable name as in papaia core)
OIDC_ISSUER_KC_AUTH=https://keycloak.example.com/realms/papaia/protocol/openid-connect/auth
# Server-side token endpoint; use internal Docker DNS in production
OIDC_ISSUER_KC_TOKEN=http://keycloak:8080/realms/papaia/protocol/openid-connect/token
# JWKS endpoint for id_token signature verification
OIDC_ISSUER_KC_CERTS=http://keycloak:8080/realms/papaia/protocol/openid-connect/certs
# Claim name that carries the user's roles
OIDC_ROLE_CLAIM=roles
# Auth provider type: internal_keycloak | external_oidc
AUTH_PROVIDER=internal_keycloak

# --- papaia-manager ---
# Keycloak realm role granting full access (add-ons, catalogs, jobs, dashboard)
MANAGER_ADMIN_ROLE=manager-admin
# Keycloak realm role granting dashboard-only access. Admins have it implicitly.
MANAGER_USER_ROLE=user
# Keycloak realm role that may manage the users and roles of the realm (the Users page).
# The manager calls Keycloak's Admin API with the signed-in user's own token, so this
# role must also carry Keycloak's user-administration rights (realm-management:
# manage-users, view-users, query-users, view-realm).
MANAGER_IDENTITY_ADMIN_ROLE=papaia-admin
# Public base URL of the manager (used as OIDC redirect URI base)
MANAGER_HOST=http://localhost:8120
# Keycloak client ID registered in the papaia realm
MANAGER_OIDC_CLIENT_ID=papaia-manager
# Keycloak client secret (set by papaia-ctl setup or generated via GENERATE_KC_MANAGER_CLIENT_SECRET)
MANAGER_OIDC_CLIENT_SECRET=CHANGE_ME
# itsdangerous session signing key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
MANAGER_SESSION_SECRET=GENERATE_MANAGER_SESSION_SECRET

# --- Paths (MUST equal host paths; see docker-compose.yml volume mounts) ---
# Host path to the papAIa workspace (contains papaia/ checkout and addons/)
PAPAIA_WORKSPACE_DIR=/srv/papaia/workspace
# Host path to the papAIa config directory
PAPAIA_CONFIG_DIR=/srv/papaia/config
# Host path to the papAIa backup directory (PAPAIA_BACKUP_DIR in the stack's root
# .env). Holds the restore-point catalogue the Backup / Restore page reads and the
# snapshots it restores from. `papaia-ctl setup` derives it as
# $PAPAIA_WORKSPACE_DIR/backup unless --backup-dir=PATH was passed.
PAPAIA_BACKUP_DIR=/srv/papaia/workspace/backup

# --- RAG system (optional) ---
# Where the manager itself reaches the RAG system's Qdrant. In the stack the default
# resolves on the network the manager shares with it. This compose file does not join
# that network, so here it has to be set to an address the container can reach. It
# replaces the address of the connection to the integrated Qdrant when the manager
# connects, and is never written to the connection store, which the ingester reads: the
# ingester always uses http://qdrant:6333.
# The api-keys and the connections live in the ingester's store
# (ai/rag/catalog/connections.yaml); the secrets and the collection and role names are
# read at request time from $PAPAIA_CONFIG_DIR/ai/rag/.env, not set here.
# QDRANT_URL=http://qdrant:6333
# Where the manager reaches the ingester's REST API. In the stack that is the same
# network; as above, set it here to an address this container can reach. It is not the
# ingester's public URL. The token it needs (QI_API_TOKEN) is read at request time from
# $PAPAIA_CONFIG_DIR/ai/rag/.env.
# QDRANT_INGEST_URL=http://qdrant-ingest:8300
# The Embedding page's upload area. An upload that was not embedded successfully is deleted
# after this many hours; the sizes are in MiB, per file and per upload.
# INGEST_UPLOAD_TTL_HOURS=24
# INGEST_MAX_UPLOAD_MB=200
# INGEST_MAX_BATCH_MB=2048

# --- Docker socket access ---
# GID that owns /var/run/docker.sock, so the container's non-root 'app' user
# can reach the Docker API for papaia-ctl compose operations. Discover it with:
#   docker run --rm -v /var/run/docker.sock:/var/run/docker.sock alpine \
#     stat -c '%g' /var/run/docker.sock
DOCKER_GID=999

# --- TLS (optional) ---
# Path to a custom CA certificate bundle (for internal Docker DNS + self-signed TLS)
# SSL_CERT_FILE=/certs/local-ca.crt

# --- Logging ---
LOG_LEVEL=INFO
