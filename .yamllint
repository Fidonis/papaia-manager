extends: default

ignore: |
  .venv/
  .pk/
  # Files exactly as an older release wrote them (tests/test_upgrade_from_1_6_0.py).
  tests/fixtures/manager-1.6.0/

rules:
  line-length: disable
  comments-indentation: disable
  document-start: disable
  truthy:
    check-keys: false
  colons:
    max-spaces-after: -1
  comments:
    require-starting-space: false
    min-spaces-from-content: 1
