msgstr "Einmal ausführen, wenn ein geplanter Lauf verpasst wurde"

msgid "Never"
msgstr "Nie"

msgid "Always run when the ingester starts"
msgstr "Immer ausführen, wenn der Ingester startet"

msgid "Documents"
msgstr "Dokumente"

msgid "Text and Markdown"
msgstr "Text und Markdown"

