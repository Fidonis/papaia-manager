msgstr "ist kein gültiges JSON: %(msg)s"

msgid "must be a JSON object"
msgstr "muss ein JSON-Objekt sein"

msgid "a number is expected"
msgstr "eine Zahl wird erwartet"

msgid "a whole number is expected"
msgstr "eine ganze Zahl wird erwartet"

