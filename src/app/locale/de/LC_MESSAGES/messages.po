msgid_plural "%(value)s files tracked, %(value3)s chunks written"
msgstr[0] "%(value)s Datei verfolgt, %(value3)s Chunks geschrieben"
msgstr[1] "%(value)s Dateien verfolgt, %(value3)s Chunks geschrieben"

msgid "When a job is deleted or renamed, what it embedded stays in its collection, and the ingester keeps its records of it. They are listed here until you remove them. Removing deletes the points from the collection and cannot be undone."
msgstr "Wenn ein Job gelöscht oder umbenannt wird, bleibt das, was er eingebettet hat, in seiner Collection, und der Ingester behält seine Aufzeichnungen dazu. Sie werden hier aufgeführt, bis Sie sie entfernen. Das Entfernen löscht die Punkte aus der Collection und kann nicht rückgängig gemacht werden."

msgid "Nothing is left over"
msgstr "Es ist nichts übrig"

msgid "Every job the ingester has content for is in the catalog."
msgstr "Jeder Job, für den der Ingester Inhalt hält, steht im Katalog."

msgid "Points"
msgstr "Punkte"

msgid "The job is in jobs.yaml but the ingester does not load it"
msgstr "Der Job steht in jobs.yaml, aber der Ingester lädt ihn nicht"

msgid "still in jobs.yaml"
msgstr "steht noch in jobs.yaml"

msgid "Repair the job"
msgstr "Den Job reparieren"

#, python-brace-format
msgid "Remove what <span class=\"font-mono\">{job_id}</span> left?"
msgstr "Entfernen, was <span class=\"font-mono\">{job_id}</span> hinterlassen hat?"

#, python-brace-format
msgid "This deletes its points ({points}) from <span class=\"font-mono\">{collection}</span> and the ingester's records of its files. It cannot be undone."
msgstr "Das löscht seine Punkte ({points}) aus <span class=\"font-mono\">{collection}</span> und die Aufzeichnungen des Ingesters zu seinen Dateien. Das kann nicht rückgängig gemacht werden."

msgid "Type the id of the job to confirm"
msgstr "Geben Sie zur Bestätigung die ID des Jobs ein"

msgid "The filters match no file. For a remote source this is also what the ingester sees before the first run has fetched anything."
msgstr "Die Filter passen auf keine Datei. Bei einer entfernten Quelle ist das auch das, was der Ingester sieht, bevor der erste Lauf etwas abgerufen hat."

msgid "Size"
msgstr "Größe"

#, python-format
msgid "%(count)s file shown"
msgid_plural "%(count)s files shown"
msgstr[0] "%(count)s Datei angezeigt"
msgstr[1] "%(count)s Dateien angezeigt"

