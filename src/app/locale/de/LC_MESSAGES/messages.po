msgid "docker image ls gave unreadable output: %(exc)s"
msgstr "docker image ls lieferte eine unlesbare Ausgabe: %(exc)s"

#, python-format
msgid "docker image inspect gave unreadable output: %(exc)s"
msgstr "docker image inspect lieferte eine unlesbare Ausgabe: %(exc)s"

msgid "the papaia checkout has no src/docker-compose.yml"
msgstr "Der papaia-Checkout enthält keine src/docker-compose.yml"

#, python-format
msgid "deployment.yaml could not be read: %(exc)s"
msgstr "deployment.yaml konnte nicht gelesen werden: %(exc)s"

#, python-format
msgid "add-on %(name)s: %(path)s/docker-compose.yml does not exist"
msgstr "Add-on %(name)s: %(path)s/docker-compose.yml existiert nicht"

#, python-format
msgid "Keycloak is not reachable at %(where)s (%(__name__)s)"
msgstr "Keycloak ist unter %(where)s nicht erreichbar (%(__name__)s)"

msgid "Keycloak refused the session token"
msgstr "Keycloak hat das Sitzungs-Token abgelehnt"

#, python-format
msgid "Keycloak failed: %(detail)s"
msgstr "Keycloak ist fehlgeschlagen: %(detail)s"

msgid "Keycloak sent an unreadable answer"
msgstr "Keycloak hat eine unlesbare Antwort gesendet"

msgid "Keycloak created the user but did not say which"
msgstr "Keycloak hat den Benutzer angelegt, aber nicht gesagt, welchen"

msgid "LITELLM_MASTER_KEY is not set in ai/litellm/.env, so the manager cannot read from LiteLLM."
msgstr "LITELLM_MASTER_KEY ist in ai/litellm/.env nicht gesetzt, daher kann der Manager nicht aus LiteLLM lesen."

msgid "LiteLLM refused the master key. Check LITELLM_MASTER_KEY in ai/litellm/.env; LiteLLM reads it at start, so it needs a restart after a change."
msgstr "LiteLLM hat den Master-Key abgelehnt. Prüfen Sie LITELLM_MASTER_KEY in ai/litellm/.env; LiteLLM liest ihn beim Start, nach einer Änderung ist also ein Neustart nötig."

#, python-format
msgid "LiteLLM is not reachable at %(where)s (%(error)s)."
msgstr "LiteLLM ist unter %(where)s nicht erreichbar (%(error)s)."

#, python-format
msgid "LiteLLM answered with an error: %(detail)s"
msgstr "LiteLLM hat mit einem Fehler geantwortet: %(detail)s"

msgid "LiteLLM sent an answer the manager could not read."
msgstr "LiteLLM hat eine Antwort gesendet, die der Manager nicht lesen konnte."

msgid "Unknown time window."
msgstr "Unbekanntes Zeitfenster."

msgid "Enter both dates."
msgstr "Bitte beide Daten eingeben."

msgid "Dates must look like 2026-10-24."
msgstr "Das Datum muss so aussehen: 2026-10-24."

msgid "The start date is after the end date."
msgstr "Das Startdatum liegt nach dem Enddatum."

msgid "The end date can't be in the future."
msgstr "Das Enddatum darf nicht in der Zukunft liegen."

#, python-format
msgid "A window can't be longer than %(days)s days."
msgstr "Ein Zeitfenster darf höchstens %(days)s Tage lang sein."

msgid "Chat"
msgstr "Chat"

msgid "Embedding"
msgstr "Embedding"

msgid "Completion"
msgstr "Completion"

msgid "Image generation"
msgstr "Bilderzeugung"

msgid "Transcription"
msgstr "Transkription"

msgid "Speech"
msgstr "Sprachausgabe"

msgid "Rerank"
msgstr "Rerank"

msgid "Moderation"
msgstr "Moderation"

msgid "Check the api-key of this connection."
msgstr "Prüfen Sie den API-Key dieser Verbindung."

#, python-format
msgid "Qdrant is not reachable at %(where)s (%(__name__)s)"
msgstr "Qdrant ist unter %(where)s nicht erreichbar (%(__name__)s)"

#, python-format
msgid "Qdrant refused the api-key. %(_refused_hint)s"
msgstr "Qdrant hat den API-Key abgelehnt. %(_refused_hint)s"

msgid "Qdrant sent an unreadable answer"
msgstr "Qdrant hat eine unlesbare Antwort gesendet"

#, python-format
msgid "%(first_key)s is %(first)r but %(second_key)s is %(second)r. The MCP server and the ingester must use the same name; the manager follows the first."
msgstr "%(first_key)s ist %(first)r, aber %(second_key)s ist %(second)r. Der MCP-Server und der Ingester müssen denselben Namen verwenden; der Manager folgt dem ersten."

#, python-format
msgid "%(key)s in ai/rag/.env contains a variable, which the manager does not expand. Write the folder out in full."
msgstr "%(key)s in ai/rag/.env enthält eine Variable, die der Manager nicht auflöst. Schreiben Sie den Ordner vollständig aus."

#, python-format
msgid "%(key)s points to %(mount)s, which the manager cannot see: it mounts only its configuration and workspace directories. Embedding from the manager needs the documents folder inside one of them."
msgstr "%(key)s zeigt auf %(mount)s, das der Manager nicht sehen kann: Er bindet nur sein Konfigurations- und sein Workspace-Verzeichnis ein. Das Einbetten aus dem Manager setzt voraus, dass der Dokumentenordner in einem davon liegt."

#, python-format
msgid "The documents folder %(chosen)s does not exist. Create it (the stack's setup does when the RAG system is chosen) and start the RAG services again."
msgstr "Der Dokumentenordner %(chosen)s existiert nicht. Legen Sie ihn an (das Setup des Stacks tut das, wenn das RAG-System gewählt wird) und starten Sie die RAG-Dienste erneut."

#, python-format
msgid "A collection name starts with a letter or digit and contains only letters, digits, '.', '_' and '-' (at most %(MAX_NAME_LENGTH)s characters)."
msgstr "Ein Collection-Name beginnt mit einem Buchstaben oder einer Ziffer und enthält nur Buchstaben, Ziffern, „.“, „_“ und „-“ (höchstens %(MAX_NAME_LENGTH)s Zeichen)."

#, python-format
msgid "%(name)r is a system collection."
msgstr "%(name)r ist eine System-Collection."

msgid "Not a valid collection name."
msgstr "Kein gültiger Collection-Name."

#, python-format
msgid "The vector size must be between 1 and %(MAX_VECTOR_SIZE)s."
msgstr "Die Vektorgröße muss zwischen 1 und %(MAX_VECTOR_SIZE)s liegen."

msgid "Not a valid embedding model name."
msgstr "Kein gültiger Name für ein Embedding-Modell."

msgid "A role name must not be empty."
msgstr "Ein Rollenname darf nicht leer sein."

#, python-format
msgid "A role name is at most %(MAX_NAME_LENGTH)s characters."
msgstr "Ein Rollenname hat höchstens %(MAX_NAME_LENGTH)s Zeichen."

#, python-format
msgid "%(value)r is not a valid role name."
msgstr "%(value)r ist kein gültiger Rollenname."

#, python-format
msgid "The access level must be one of %(value)s."
msgstr "Die Zugriffsstufe muss einen der Werte %(value)s haben."

#, python-format
msgid "%(role)r always has access to every collection and is not listed per collection."
msgstr "%(role)r hat immer Zugriff auf jede Collection und wird nicht pro Collection aufgeführt."

#, python-format
msgid "The role %(role)r is listed twice."
msgstr "Die Rolle %(role)r ist doppelt aufgeführt."

#, python-format
msgid "Qdrant answered with an error: %(detail)s"
msgstr "Qdrant hat mit einem Fehler geantwortet: %(detail)s"

msgid "Logins, users and realm data"
msgstr "Anmeldungen, Benutzer und Realm-Daten"

msgid "The realm carries every service's client secret and is imported only on first start. Restoring the database on its own would leave those secrets out of step with the live configuration and no sign-in would work, this panel included, so the stack configuration is restored with it."
msgstr "Der Realm enthält das Client-Secret jedes Dienstes und wird nur beim ersten Start importiert. Würde die Datenbank allein wiederhergestellt, stimmten diese Secrets nicht mehr mit der laufenden Konfiguration überein und keine Anmeldung würde funktionieren, auch nicht in diesem Panel. Deshalb wird die Stack-Konfiguration mit wiederhergestellt."

msgid "Every active session ends. You will have to sign in again."
msgstr "Alle aktiven Sitzungen enden. Sie müssen sich erneut anmelden."

msgid "Conversations, uploads, search index and embeddings"
msgstr "Unterhaltungen, Uploads, Suchindex und Embeddings"

msgid "Conversations, the search index, the embeddings and the uploaded files reference each other by id. Restoring the whole module keeps them consistent; picking single volumes below can leave hits on deleted conversations, empty retrieval results, or file records with no file."
msgstr "Unterhaltungen, der Suchindex, die Embeddings und die hochgeladenen Dateien verweisen über IDs aufeinander. Wird das ganze Modul wiederhergestellt, bleiben sie konsistent; einzelne Volumes unten können Treffer auf gelöschte Unterhaltungen, leere Suchergebnisse oder Dateieinträge ohne Datei hinterlassen."

msgid "Model routing, virtual keys and spend"
msgstr "Modell-Routing, virtuelle Schlüssel und Kosten"

msgid "Every virtual key issued since the snapshot stops working. Their holders get 401 until the keys are reissued."
msgstr "Jeder seit dem Snapshot ausgestellte virtuelle Schlüssel funktioniert nicht mehr. Seine Inhaber erhalten 401, bis die Schlüssel neu ausgestellt werden."

msgid "Local accounts and downloaded models"
msgstr "Lokale Konten und heruntergeladene Modelle"

msgid "Restoring the local account store can bring back accounts that were deleted since the snapshot."
msgstr "Die Wiederherstellung des lokalen Kontenspeichers kann Konten zurückbringen, die seit dem Snapshot gelöscht wurden."

msgid "Search settings and cache"
msgstr "Sucheinstellungen und Cache"

msgid "The settings file itself is mounted over this volume from the configuration directory, so restoring it changes less than it looks like."
msgstr "Die Einstellungsdatei selbst wird aus dem Konfigurationsverzeichnis über dieses Volume gemountet; die Wiederherstellung ändert daher weniger, als es scheint."

msgid "Users and realm"
msgstr "Benutzer und Realm"

msgid "Conversations"
msgstr "Unterhaltungen"

msgid "Search index"
msgstr "Suchindex"

msgid "Embeddings"
msgstr "Embeddings"

msgid "Uploaded files"
msgstr "Hochgeladene Dateien"

msgid "Generated images"
msgstr "Erzeugte Bilder"

msgid "Keys, budgets and spend"
msgstr "Schlüssel, Budgets und Kosten"

msgid "Local accounts and generated data"
msgstr "Lokale Konten und erzeugte Daten"

msgid "Downloaded model weights"
msgstr "Heruntergeladene Modellgewichte"

msgid "Settings volume"
msgstr "Einstellungs-Volume"

msgid "The reverse proxy, its certificates and every rendered service config live in the stack configuration, not in a volume. They come back only with a full restore."
msgstr "Der Reverse Proxy, seine Zertifikate und jede erzeugte Dienstkonfiguration liegen in der Stack-Konfiguration, nicht in einem Volume. Sie kommen nur mit einer vollständigen Wiederherstellung zurück."

msgid "Stack configuration"
msgstr "Stack-Konfiguration"

msgid "Environment files, rendered service configs, proxy database and certificates"
msgstr "Umgebungsdateien, erzeugte Dienstkonfigurationen, Proxy-Datenbank und Zertifikate"

msgid "The configuration archive covers the whole bundle and cannot be unpacked in part, and every core service bind-mounts individual files out of it -- so all containers have to be removed and recreated for the restored files to be picked up."
msgstr "Das Konfigurationsarchiv umfasst das gesamte Bundle und kann nicht teilweise entpackt werden, und jeder Core-Dienst bindet einzelne Dateien daraus ein – deshalb müssen alle Container entfernt und neu erstellt werden, damit die wiederhergestellten Dateien übernommen werden."

msgid "Because that includes this panel, the operation runs in its own container and this page is unreachable while it does."
