msgstr "Der Job %(job_id)r steht nicht mehr in jobs.yaml."

msgid "jobs.yaml changed since it was opened. Reload the page to see the current content."
msgstr "jobs.yaml hat sich geändert, seit sie geöffnet wurde. Laden Sie die Seite neu, um den aktuellen Inhalt zu sehen."

msgid "jobs.yaml changed while it was being saved. Reload the page and try again."
msgstr "jobs.yaml hat sich geändert, während sie gespeichert wurde. Laden Sie die Seite neu und versuchen Sie es erneut."

#, python-format
msgid "%(directory)s does not exist; the manager does not create it"
msgstr "%(directory)s existiert nicht; der Manager legt es nicht an"

#, python-format
msgid "%(directory)s does not accept the change (%(value)s); the job catalog is read-only here"
msgstr "%(directory)s nimmt die Änderung nicht an (%(value)s); der Job-Katalog ist hier schreibgeschützt"

#, python-format
msgid "The job %(job_id)r was changed by somebody else since it was opened. Reload it to see the current version."
msgstr "Der Job %(job_id)r wurde von jemand anderem geändert, seit er geöffnet wurde. Laden Sie ihn neu, um die aktuelle Version zu sehen."

msgid "the ingester kept its previous job catalog"
msgstr "Der Ingester hat seinen vorherigen Job-Katalog behalten"

#, python-format
msgid "The ingester did not take the job: %(problems)s"
msgstr "Der Ingester hat den Job nicht übernommen: %(problems)s"

msgid "QI_API_TOKEN is not set in ai/rag/.env, so the manager cannot call the ingester."
msgstr "QI_API_TOKEN ist in ai/rag/.env nicht gesetzt, deshalb kann der Manager den Ingester nicht aufrufen."

msgid "The ingester refused the API token. Check QI_API_TOKEN in ai/rag/.env; the ingester reads it at start, so it needs a restart after a change."
msgstr "Der Ingester hat das API-Token abgelehnt. Prüfen Sie QI_API_TOKEN in ai/rag/.env; der Ingester liest es beim Start, braucht also nach einer Änderung einen Neustart."

#, python-format
msgid "The ingester is not reachable at %(where)s (%(__name__)s)."
msgstr "Der Ingester ist unter %(where)s nicht erreichbar (%(__name__)s)."

msgid "The ingester sent an unreadable answer"
msgstr "Der Ingester hat eine unlesbare Antwort gesendet"

msgid "The ingester's health check failed"
msgstr "Die Gesundheitsprüfung des Ingesters ist fehlgeschlagen"

msgid "This ingester does not support updating without deleting. Use an ingester release that has the delete_vanished run option."
msgstr "Dieser Ingester unterstützt das Aktualisieren ohne Löschen nicht. Verwenden Sie ein Ingester-Release mit der Lauf-Option delete_vanished."

msgid "The ingester did not name the run it started"
msgstr "Der Ingester hat den gestarteten Lauf nicht benannt"

