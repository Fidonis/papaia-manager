msgstr "Wählen Sie mindestens eine Datei oder einen Ordner."

#, python-format
msgid "That is %(value)s separate selections; select their folder instead (at most %(MAX_INCLUDES)s)."
msgstr "Das sind %(value)s getrennte Auswahlen; wählen Sie stattdessen deren Ordner (höchstens %(MAX_INCLUDES)s)."

