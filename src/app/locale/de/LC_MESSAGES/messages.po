msgid "session expired"
msgstr "Sitzung abgelaufen"

msgid "You do not have access to this page."
msgstr "Sie haben keinen Zugriff auf diese Seite."

msgid "Access denied"
msgstr "Zugriff verweigert"

msgid "csrf token missing"
msgstr "CSRF-Token fehlt"

msgid "csrf token invalid"
msgstr "CSRF-Token ungültig"

msgid "not authenticated"
msgstr "nicht angemeldet"

msgid "invalid session"
msgstr "ungültige Sitzung"

msgid "admin role required"
msgstr "Admin-Rolle erforderlich"

#, python-format
msgid "the %(manager_identity_admin_role)s role is required to manage users and roles"
msgstr "Die Rolle %(manager_identity_admin_role)s ist erforderlich, um Benutzer und Rollen zu verwalten"

msgid "admin or user role required"
msgstr "Admin- oder Benutzer-Rolle erforderlich"

#, python-format
msgid "logout request failed: %(__name__)s"
msgstr "Abmelde-Anfrage fehlgeschlagen: %(__name__)s"

#, python-format
msgid "logout request failed with HTTP %(status_code)s"
msgstr "Abmelde-Anfrage fehlgeschlagen mit HTTP %(status_code)s"

#, python-format
msgid "token request failed with HTTP %(status_code)s"
msgstr "Token-Anfrage fehlgeschlagen mit HTTP %(status_code)s"

msgid "Token response missing id_token"
msgstr "In der Token-Antwort fehlt das id_token"

msgid "malformed id_token header"
msgstr "fehlerhafter id_token-Header"

msgid "id_token header missing kid"
msgstr "Im id_token-Header fehlt kid"

msgid "id_token expired"
msgstr "id_token abgelaufen"

msgid "id_token validation failed"
msgstr "Validierung des id_token fehlgeschlagen"

msgid "signing key not found in JWKS"
msgstr "Signaturschlüssel nicht in JWKS gefunden"

#, python-format
msgid "unsupported JWK key type: %(kty)r"
msgstr "nicht unterstützter JWK-Schlüsseltyp: %(kty)r"

#, python-format
msgid "JWK algorithm not permitted: %(alg)r"
msgstr "JWK-Algorithmus nicht zulässig: %(alg)r"

msgid "id_token missing required sub claim"
msgstr "Im id_token fehlt der Claim sub"

msgid "id_token missing exp claim"
msgstr "Im id_token fehlt der Claim exp"

#, python-format
msgid "%(value)r is not a valid date or datetime"
msgstr "%(value)r ist kein gültiges Datum und keine gültige Zeitangabe"

#, python-brace-format, python-format
msgid "catalog name %(name)r must match ^[a-z0-9][a-z0-9-]{0,31}$"
msgstr "Der Katalogname %(name)r muss auf ^[a-z0-9][a-z0-9-]{0,31}$ passen"

#, python-format
msgid "catalog URL must start with https://; got %(url)r"
msgstr "Die Katalog-URL muss mit https:// beginnen, erhalten: %(url)r"

#, python-format
msgid "catalog ref %(ref)r contains invalid characters"
msgstr "Die Katalog-Referenz %(ref)r enthält ungültige Zeichen"

#, python-format
msgid "local catalog path must reside under PAPAIA_WORKSPACE_DIR (%(workspace)s); got %(resolved)s"
msgstr "Ein lokaler Katalogpfad muss unter PAPAIA_WORKSPACE_DIR (%(workspace)s) liegen, erhalten: %(resolved)s"

#, python-format
msgid "verb %(verb)r is not in the allowed set %(value)s"
msgstr "Das Verb %(verb)r gehört nicht zu den erlaubten Verben %(value)s"

#, python-brace-format, python-format
msgid "addon name %(name)r does not match ^[a-z0-9][a-z0-9-]{0,31}$"
msgstr "Der Add-on-Name %(name)r passt nicht auf ^[a-z0-9][a-z0-9-]{0,31}$"

msgid "no service group given"
msgstr "keine Dienstgruppe angegeben"

#, python-brace-format, python-format
msgid "profile %(name)r does not match ^[a-z0-9][a-z0-9-]{0,31}$"
msgstr "Das Profil %(name)r passt nicht auf ^[a-z0-9][a-z0-9-]{0,31}$"

#, python-format
msgid "profile %(name)r runs this panel and cannot be controlled from it"
msgstr "Das Profil %(name)r betreibt dieses Panel und kann nicht von hier aus gesteuert werden"

#, python-format
msgid "profile %(name)r is not a service group of this deployment"
msgstr "Das Profil %(name)r ist keine Dienstgruppe dieser Installation"

msgid "no selection given"
msgstr "keine Auswahl angegeben"

#, python-format
msgid "at most %(MAX_SELECTORS)s selectors, got %(value)s"
msgstr "höchstens %(MAX_SELECTORS)s Selektoren erlaubt, erhalten: %(value)s"

#, python-format
msgid "selector %(selector)r is not module:NAME, addon:NAME or volume:NAME"
msgstr "Der Selektor %(selector)r hat nicht die Form module:NAME, addon:NAME oder volume:NAME"

#, python-format
msgid "selector %(selector)r runs this panel and cannot be restored from it"
msgstr "Der Selektor %(selector)r betrifft dieses Panel und kann nicht von hier aus wiederhergestellt werden"

#, python-format
msgid "selector %(selector)r is not part of this restore point"
msgstr "Der Selektor %(selector)r gehört nicht zu diesem Wiederherstellungspunkt"

#, python-format
msgid "command %(command)r is not in the allowed set %(value)s"
msgstr "Der Befehl %(command)r gehört nicht zu den erlaubten Befehlen %(value)s"

#, python-format
msgid "%(label)s must be a non-empty single line"
msgstr "%(label)s muss eine nicht leere einzelne Zeile sein"

msgid "switching the relay off takes no other setting"
msgstr "Beim Abschalten des Relays sind keine weiteren Einstellungen erlaubt"

msgid "there is nothing to store"
msgstr "Es gibt nichts zu speichern"

msgid "a mail server without login takes neither a login nor a password"
msgstr "Ein Mailserver ohne Anmeldung nimmt weder einen Benutzernamen noch ein Passwort an"

msgid "host, security, port and sender address are required"
msgstr "Host, Verschlüsselung, Port und Absenderadresse sind erforderlich"

#, python-format
msgid "security must be one of %(value)s"
msgstr "Die Verschlüsselung muss einen der Werte %(value)s haben"

msgid "port must be between 1 and 65535"
msgstr "Der Port muss zwischen 1 und 65535 liegen"

msgid "setup is not an allowed write command"
msgstr "setup ist kein erlaubter Schreibbefehl"

#, python-format
msgid "the URL must have 1-%(MAX_URL_LENGTH)s characters"
msgstr "Die URL muss 1 bis %(MAX_URL_LENGTH)s Zeichen lang sein"

msgid "the URL may not contain spaces, control characters or any of # $ \" ' \\ `"
msgstr "Die URL darf keine Leerzeichen, Steuerzeichen oder eines der Zeichen # $ \" ' \\ ` enthalten"

msgid "this is not a valid URL (expected https://host:port)"
msgstr "Das ist keine gültige URL (erwartet wird https://Host:Port)"

msgid "the URL must start with http:// or https:// and name a host"
msgstr "Die URL muss mit http:// oder https:// beginnen und einen Host nennen"

msgid "the URL may not contain a login, a query or a fragment"
msgstr "Die URL darf weder Anmeldedaten noch Query oder Fragment enthalten"

#, python-format
msgid "module %(module)r cannot be switched from here"
msgstr "Das Modul %(module)r kann von hier aus nicht umgeschaltet werden"

#, python-format
msgid "%(module)s takes no public URL"
msgstr "%(module)s hat keine öffentliche URL"

msgid "switching a module off takes no public URL"
msgstr "Beim Abschalten eines Moduls ist keine öffentliche URL erlaubt"

msgid "only LocalAI takes an image variant"
msgstr "Nur LocalAI hat eine Image-Variante"

msgid "switching LocalAI off takes no variant"
msgstr "Beim Abschalten von LocalAI ist keine Variante erlaubt"

#, python-format
msgid "variant must be one of %(value)s"
msgstr "Die Variante muss einen der Werte %(value)s haben"

#, python-format
msgid "module %(name)r is not one of %(value)s"
msgstr "Das Modul %(name)r gehört nicht zu %(value)s"

msgid "module-purge is not an allowed write command"
msgstr "module-purge ist kein erlaubter Schreibbefehl"

msgid "name what to delete: the data, the settings or both"
msgstr "Geben Sie an, was gelöscht werden soll: die Daten, die Einstellungen oder beides"

msgid "Images"
msgstr "Images"

msgid "Containers"
msgstr "Container"

msgid "Volumes"
msgstr "Volumes"

msgid "Build cache"
msgstr "Build-Cache"

#, python-format
msgid "%(size)s reclaimable"
msgstr "%(size)s freigebbar"

#, python-format
msgid "%(count)s total"
msgstr "%(count)s gesamt"

#, python-format
msgid "%(count)s active"
msgstr "%(count)s aktiv"

msgid "doctor did not return JSON"
msgstr "doctor hat kein JSON zurückgegeben"

msgid "doctor did not return a JSON object"
msgstr "doctor hat kein JSON-Objekt zurückgegeben"

#, python-format
msgid "doctor reports schema %(value)r, not 1"
msgstr "doctor meldet das Schema %(value)r statt 1"

msgid "doctor did not report docker_usage"
msgstr "doctor hat docker_usage nicht gemeldet"

msgid "docker_usage could not be read"
msgstr "docker_usage konnte nicht gelesen werden"

msgid "doctor reported docker_usage without figures"
msgstr "doctor hat docker_usage ohne Zahlen gemeldet"

msgid "this papAIa core has no docker_usage check"
msgstr "Dieser papAIa-Core hat keine docker_usage-Prüfung"

#, python-format
msgid "doctor exited with status %(code)s and no output"
msgstr "doctor wurde mit Status %(code)s und ohne Ausgabe beendet"

msgid "the Docker usage check failed unexpectedly"
msgstr "Die Docker-Nutzungsprüfung ist unerwartet fehlgeschlagen"

msgid "generated automatically"
msgstr "wird automatisch generiert"

msgid "enter after the Keycloak import"
msgstr "nach Keycloak-Import eintragen"

msgid "value must not contain newline or carriage-return characters"
msgstr "Der Wert darf keine Zeilenumbrüche oder Wagenrückläufe enthalten"

msgid "required field must not be empty"
msgstr "Pflichtfeld darf nicht leer sein"

#, python-format
msgid "expected integer, got %(value)r"
msgstr "Ganzzahl erwartet, erhalten: %(value)r"

#, python-format
msgid "value %(int_val)s is below minimum %(min_value)s"
msgstr "Der Wert %(int_val)s liegt unter dem Minimum %(min_value)s"

#, python-format
msgid "value %(int_val)s exceeds maximum %(max_value)s"
msgstr "Der Wert %(int_val)s überschreitet das Maximum %(max_value)s"

#, python-format
msgid "expected decimal number, got %(value)r"
msgstr "Dezimalzahl erwartet, erhalten: %(value)r"

#, python-format
msgid "value %(dec_val)s is below minimum %(min_value)s"
msgstr "Der Wert %(dec_val)s liegt unter dem Minimum %(min_value)s"

#, python-format
msgid "value %(dec_val)s exceeds maximum %(max_value)s"
msgstr "Der Wert %(dec_val)s überschreitet das Maximum %(max_value)s"

#, python-format
msgid "expected a URL with http or https scheme and a host, got %(value)r"
msgstr "Erwartet wird eine URL mit dem Schema http oder https und einem Host, erhalten: %(value)r"

#, python-format
msgid "value %(value)r does not match required pattern %(pattern)r"
msgstr "Der Wert %(value)r entspricht nicht dem geforderten Muster %(pattern)r"

msgid "This papAIa core does not provide doctor yet. Upgrade the core to 1.4.0 or newer."
msgstr "Dieser papAIa-Core bietet doctor noch nicht. Aktualisieren Sie den Core auf 1.4.0 oder neuer."

msgid "the host check failed unexpectedly"
msgstr "Die Host-Prüfung ist unerwartet fehlgeschlagen"

