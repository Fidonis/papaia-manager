msgstr "GPU %(number)s"

msgid "not synchronized"
msgstr "nicht synchronisiert"

msgid "System clock"
msgstr "Systemuhr"

msgid "doctor reported none of the host checks"
msgstr "doctor hat keine der Host-Prüfungen gemeldet"

#, python-format
msgid "cannot invoke docker: %(exc)s"
msgstr "docker kann nicht aufgerufen werden: %(exc)s"

#, python-format
msgid "%(value)s timed out after %(limit).0fs"
msgstr "%(value)s hat nach %(limit).0f s das Zeitlimit überschritten"

