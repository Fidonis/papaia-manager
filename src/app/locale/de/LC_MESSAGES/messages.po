msgstr "papaia-ctl %(verb)s: %(value)s"

#, python-format
msgid "%(exc)s %(title)s is switched on in the configuration but did not start. Fix the cause and start it from the Services page, or switch it off here."
msgstr "%(exc)s %(title)s ist in der Konfiguration eingeschaltet, hat aber nicht gestartet. Beheben Sie die Ursache und starten Sie es auf der Seite „Dienste“, oder schalten Sie es hier aus."

#, python-format
msgid "The relay is running, but Keycloak was not given its mail server (%(realm)s). Switch it off and on again once that is fixed."
msgstr "Das Relay läuft, aber Keycloak hat seinen Mailserver nicht erhalten (%(realm)s). Schalten Sie es aus und wieder ein, sobald das behoben ist."

#, python-format
msgid "%(title)s is switched on, but %(value)s%(value2)s Check the service log, or switch it off again."
msgstr "%(title)s ist eingeschaltet, aber %(value)s%(value2)s Prüfen Sie das Dienst-Log, oder schalten Sie es wieder aus."

#, python-format
msgid "%(title)s is off, but its %(what)s could not be deleted: %(value)s"
msgstr "%(title)s ist aus, aber %(what)s konnten nicht gelöscht werden: %(value)s"

msgid "The overlay file changed after the page loaded it. Nothing was changed."
msgstr "Die Overlay-Datei hat sich geändert, nachdem die Seite sie geladen hatte. Es wurde nichts geändert."

msgid "The overlay file changed while the job ran. Nothing was changed."
msgstr "Die Overlay-Datei hat sich geändert, während der Job lief. Es wurde nichts geändert."

#, python-format
msgid "%(label)s did not start with the new overlay, so the previous version was put back. (%(exc)s)"
msgstr "%(label)s ist mit dem neuen Overlay nicht gestartet, deshalb wurde die vorherige Version zurückgespielt. (%(exc)s)"

#, python-format
msgid "The overlay is in place, but %(value)s%(value2)s The previous version is in Versions if you want to go back."
msgstr "Das Overlay ist aktiv, aber %(value)s%(value2)s Die vorherige Version steht unter „Versionen“, falls Sie zurückgehen möchten."

#, python-format
msgid "unknown source kind %(kind)r"
msgstr "unbekannte Quellart %(kind)r"

#, python-format
msgid "the connection %(connection)r is not in connections.yaml"
msgstr "Die Verbindung %(connection)r steht nicht in connections.yaml"

#, python-format
msgid "the job %(job)r writes to the collection %(collection)r on the connection %(connection)r; a collection lives in exactly one database"
msgstr "Der Job %(job)r schreibt in die Collection %(collection)r der Verbindung %(connection)r; eine Collection liegt in genau einer Datenbank"

#, python-format
msgid "the job %(job)r embeds %(collection)r with %(other)r; a collection records exactly one model, and this run uses %(model)r"
msgstr "Der Job %(job)r bettet %(collection)r mit %(other)r ein; eine Collection hält genau ein Modell fest, und dieser Lauf verwendet %(model)r"

#, python-format
msgid "the job %(job)r already uses the source label %(label)r on %(collection)r"
msgstr "Der Job %(job)r verwendet das Quell-Label %(label)r für %(collection)r bereits"

#, python-format
msgid "invalid YAML: %(first)s"
msgstr "ungültiges YAML: %(first)s"

msgid "the top level must be a mapping"
msgstr "Die oberste Ebene muss eine Zuordnung sein"

#, python-format
