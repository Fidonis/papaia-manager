msgstr "%(offset)s–%(count)s von %(value)s"

msgid "Previous"
msgstr "Zurück"

msgid "The ingester cannot be reached"
msgstr "Der Ingester ist nicht erreichbar"

#, python-format
msgid "%(reason)s The jobs below are read from <span class=\"font-mono\">jobs.yaml</span>; nothing can run and a change cannot be checked."
msgstr "%(reason)s Die Jobs unten werden aus <span class=\"font-mono\">jobs.yaml</span> gelesen; nichts kann laufen, und eine Änderung lässt sich nicht prüfen."

msgid "The ingester is up, but the manager cannot use it"
msgstr "Der Ingester läuft, aber der Manager kann ihn nicht verwenden"

#, python-format
msgid "The ingester cannot reach <b>%(names)s</b>. Runs that need it will fail until it is back."
msgid_plural "The ingester cannot reach <b>%(names)s</b>. Runs that need them will fail until it is back."
msgstr[0] "Der Ingester erreicht <b>%(names)s</b> nicht. Läufe, die ihn brauchen, schlagen fehl, bis er wieder da ist."
msgstr[1] "Der Ingester erreicht <b>%(names)s</b> nicht. Läufe, die sie brauchen, schlagen fehl, bis sie wieder da sind."

#, python-format
msgid "<span class=\"font-mono\">jobs.yaml</span> cannot be read: %(file_problem)s"
msgstr "<span class=\"font-mono\">jobs.yaml</span> kann nicht gelesen werden: %(file_problem)s"

msgid "Jobs cannot be listed or changed here until the file is repaired. <a class=\"link\" href=\"/ingest/catalog\">Open the file</a>"
msgstr "Jobs können hier nicht aufgelistet oder geändert werden, bis die Datei repariert ist. <a class=\"link\" href=\"/ingest/catalog\">Datei öffnen</a>"

#, python-format
msgid "The ingester serves its catalog from <span class=\"font-mono\">%(config_path)s</span>, not from <span class=\"font-mono\">ai/rag/catalog/jobs.yaml</span>, which is the file the manager edits. Changes made here would never reach it, so editing is switched off. Copy the catalog to <span class=\"font-mono\">ai/rag/catalog/jobs.yaml</span> (the ingester's own interface offers it)."
msgstr "Der Ingester liefert seinen Katalog aus <span class=\"font-mono\">%(config_path)s</span> aus, nicht aus <span class=\"font-mono\">ai/rag/catalog/jobs.yaml</span>, der Datei, die der Manager bearbeitet. Hier vorgenommene Änderungen würden ihn nie erreichen, deshalb ist das Bearbeiten ausgeschaltet. Kopieren Sie den Katalog nach <span class=\"font-mono\">ai/rag/catalog/jobs.yaml</span> (die eigene Oberfläche des Ingesters bietet das an)."

msgid "The catalog folder does not accept writes from the manager, so jobs are shown read-only."
msgstr "Das Katalogverzeichnis nimmt keine Schreibzugriffe des Managers an, deshalb werden Jobs schreibgeschützt angezeigt."

msgid "The ingester found problems in <span class=\"font-mono\">jobs.yaml</span> and keeps its previous catalog"
msgstr "Der Ingester hat Probleme in <span class=\"font-mono\">jobs.yaml</span> gefunden und behält seinen vorherigen Katalog"

#, python-format
msgid "Nothing that was changed since %(loaded_at)s is active, for any job, until the problems below are fixed."
msgstr "Nichts, was seit %(loaded_at)s geändert wurde, ist für irgendeinen Job aktiv, bis die Probleme unten behoben sind."

msgid "Problems that belong to no job listed here:"
msgstr "Probleme, die zu keinem hier aufgeführten Job gehören:"

msgid "Edit jobs.yaml"
msgstr "jobs.yaml bearbeiten"

msgid "Read it again now"
msgstr "Jetzt erneut lesen"

#, python-format
msgid "The ingester holds content of %(leftovers)s job that no job in <span class=\"font-mono\">jobs.yaml</span> explains. <a class=\"link\" href=\"/ingest/orphans\">Review the leftovers</a>"
msgid_plural "The ingester holds content of %(leftovers)s jobs that no job in <span class=\"font-mono\">jobs.yaml</span> explains. <a class=\"link\" href=\"/ingest/orphans\">Review the leftovers</a>"
msgstr[0] "Der Ingester hält Inhalt von %(leftovers)s Job, den kein Job in <span class=\"font-mono\">jobs.yaml</span> erklärt. <a class=\"link\" href=\"/ingest/orphans\">Reste ansehen</a>"
msgstr[1] "Der Ingester hält Inhalt von %(leftovers)s Jobs, den kein Job in <span class=\"font-mono\">jobs.yaml</span> erklärt. <a class=\"link\" href=\"/ingest/orphans\">Reste ansehen</a>"

msgid "No ingest jobs yet"
msgstr "Noch keine Ingest-Jobs"

msgid "A job tells the ingester where documents are, which collection they belong in and how often to look again. Add the first one"
msgstr "Ein Job sagt dem Ingester, wo Dokumente liegen, in welche Collection sie gehören und wie oft er wieder nachsehen soll. Fügen Sie den ersten hinzu"

msgid "once the catalog can be edited"
msgstr "sobald der Katalog bearbeitet werden kann"

