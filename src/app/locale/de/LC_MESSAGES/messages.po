msgid_plural "%(count)s days"
msgstr[0] "%(count)s Tag"
msgstr[1] "%(count)s Tage"

msgid "As written in jobs.yaml"
msgstr "Wie in jobs.yaml geschrieben"

msgid "Only what differs from the defaults is written. Credentials appear as references; the values are kept on the <a class=\"link\" href=\"/ingest/secrets\">Credentials</a> page or in <span class=\"font-mono\">ai/rag/.env</span>."
msgstr "Es wird nur geschrieben, was von den Vorgaben abweicht. Zugangsdaten erscheinen als Verweise; die Werte liegen auf der Seite <a class=\"link\" href=\"/ingest/secrets\">Zugangsdaten</a> oder in <span class=\"font-mono\">ai/rag/.env</span>."

msgid "Inherited from the catalog defaults"
msgstr "Von den Katalog-Vorgaben geerbt"

msgid "A job that does not set one of these values itself uses the catalog's. <a class=\"link\" href=\"/ingest/catalog\">Change the defaults</a>"
msgstr "Ein Job, der einen dieser Werte nicht selbst setzt, verwendet den des Katalogs. <a class=\"link\" href=\"/ingest/catalog\">Die Vorgaben ändern</a>"

msgid "This ingester does not report what happened to each file. A release with the <span class=\"font-mono\">documents</span> feature does; until then the runs and their messages are the place to look."
msgstr "Dieser Ingester meldet nicht, was mit jeder Datei geschah. Ein Release mit der Funktion <span class=\"font-mono\">documents</span> tut das; bis dahin sind die Läufe und ihre Meldungen die Stelle zum Nachsehen."

msgid "Files a run would pick up now"
msgstr "Dateien, die ein Lauf jetzt aufgreifen würde"

msgid "Show"
msgstr "Anzeigen"

msgid "Files this job tracks"
msgstr "Dateien, die dieser Job verfolgt"

msgid "Search by path"
msgstr "Nach Pfad suchen"

#, python-format
