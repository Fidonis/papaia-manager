{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "papaia-access-report.schema.json",
  "title": "papaia-ctl report permissions --format=json (POST /v1/access-reports/build of papaia-audit)",
  "description": "The permission report (format papaia.access-report/1) by person or by system. Rows are sorted by key; digest covers one row's content, checksum the content of all rows and the session limits (not the confirmation state). No content, secret or credential is part of it. Additive changes keep the format; a breaking change increments it.",
  "type": "object",
  "required": ["format", "by", "checksum", "recertification_days", "sessions", "rows"],
  "additionalProperties": false,
  "properties": {
    "format": {"const": "papaia.access-report/1"},
    "by": {"enum": ["person", "system"]},
    "checksum": {"$ref": "#/$defs/digest"},
    "recertification_days": {"type": "integer", "minimum": 30, "maximum": 730},
    "inputs_written_at": {
      "description": "When papaia-ctl wrote the inputs file the report was built from (realm sync or start), UTC.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "sessions": {
      "type": "object",
      "required": ["offline", "delegations"],
      "additionalProperties": false,
      "properties": {
        "offline": {
          "description": "Offline-session limits of the realm in days (max_age_days null: no maximum age).",
          "type": "object",
          "required": ["idle_days", "max_age_days"],
          "additionalProperties": false,
          "properties": {
            "idle_days": {"type": "integer", "minimum": 0},
            "max_age_days": {"type": ["integer", "null"], "minimum": 0}
          }
        },
        "delegations": {
          "description": "The delegation lifetime in effect (papaia-ctl delegations lifetime --json).",
          "type": "object"
        }
      }
    },
    "rows": {"type": "array", "items": {"$ref": "#/$defs/row"}}
  },
  "allOf": [
    {
      "if": {"properties": {"by": {"const": "person"}}},
      "then": {"properties": {"rows": {"items": {"$ref": "#/$defs/person"}}}}
    },
    {
      "if": {"properties": {"by": {"const": "system"}}},
      "then": {"properties": {"rows": {"items": {"$ref": "#/$defs/system"}}}}
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "names": {"type": "array", "items": {"type": "string", "maxLength": 255}, "uniqueItems": true},
    "row": {
      "type": "object",
      "required": ["key", "digest", "last_confirmed_at", "confirmation_due"],
      "properties": {
        "key": {"type": "string", "pattern": "^(person|system):[A-Za-z0-9][A-Za-z0-9._:@|+-]{0,254}$"},
        "digest": {"$ref": "#/$defs/digest"},
        "last_confirmed_at": {
          "description": "Time of the latest recertification of this row, as papaia-audit recorded it.",
          "type": ["string", "null"]
        },
        "confirmation_due": {
          "description": "No confirmation, one older than recertification_days, or one for another content.",
          "type": "boolean"
        }
      }
    },
    "person": {
      "type": "object",
      "required": [
        "key", "sub", "username", "enabled", "breakglass", "realm_roles", "module_roles",
        "groups", "service_accounts", "delegations", "separation_conflict"
      ],
      "unevaluatedProperties": false,
      "allOf": [{"$ref": "#/$defs/row"}],
      "properties": {
        "sub": {"type": "string", "maxLength": 255},
        "username": {"type": "string", "maxLength": 255},
        "enabled": {"type": "boolean"},
        "breakglass": {"description": "The emergency account (security 1.15).", "type": "boolean"},
        "realm_roles": {"$ref": "#/$defs/names"},
        "module_roles": {
          "description": "Client roles by client.",
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/names"}
        },
        "groups": {"$ref": "#/$defs/names"},
        "service_accounts": {
          "type": "object",
          "required": ["owner", "deputy"],
          "additionalProperties": false,
          "properties": {"owner": {"$ref": "#/$defs/names"}, "deputy": {"$ref": "#/$defs/names"}}
        },
        "delegations": {
          "description": "Stored delegations (offline sessions) by module client.",
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 1}
        },
        "separation_conflict": {
          "description": "The separated platform roles the person holds when more than one.",
          "$ref": "#/$defs/names"
        }
      }
    },
    "system": {
      "type": "object",
      "required": ["key", "audience", "exchange_clients", "service_accounts", "target_rights"],
      "unevaluatedProperties": false,
      "allOf": [{"$ref": "#/$defs/row"}],
      "properties": {
        "audience": {"type": "string", "maxLength": 255},
        "exchange_clients": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["client", "effects", "requested_by", "confirmed_by"],
            "additionalProperties": false,
            "properties": {
              "client": {"type": "string"},
              "effects": {"type": "array", "items": {"enum": ["r", "w", "d", "x"]}},
              "requested_by": {"type": ["string", "null"]},
              "confirmed_by": {"type": ["string", "null"]}
            }
          }
        },
        "service_accounts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "module", "effects"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string"},
              "module": {"type": ["string", "null"]},
              "effects": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "target_rights": {"const": "im Zielsystem geführt"}
      }
    }
  }
}
