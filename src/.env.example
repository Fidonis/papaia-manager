# papaia-manager — environment variables.
# Copy to src/.env for local development (never commit the copy).

# --- OIDC (Keycloak) ---
# Browser-facing authorization endpoint
OIDC_ISSUER_KC_AUTH=https://keycloak.example.com/realms/papaia/protocol/openid-connect/auth
# Server-side token endpoint (use internal Docker DNS in container)
OIDC_ISSUER_KC_TOKEN=http://keycloak:8080/realms/papaia/protocol/openid-connect/token
# JWKS endpoint for id_token signature verification
OIDC_ISSUER_KC_CERTS=http://keycloak:8080/realms/papaia/protocol/openid-connect/certs
# Claim name that carries the user's roles (default: roles)
OIDC_ROLE_CLAIM=roles
# Auth provider type: internal_keycloak | external_oidc
AUTH_PROVIDER=internal_keycloak

# --- papaia-manager application ---
# Keycloak realm role granting full access (add-ons, catalogs, jobs, dashboard)
MANAGER_ADMIN_ROLE=manager-admin
# Keycloak realm role granting dashboard-only access. Admins have it implicitly.
MANAGER_USER_ROLE=user
# Keycloak realm role that may manage the users and roles of the realm (the Users page,
# with its Roles tab).
# The manager calls Keycloak's Admin API with the signed-in user's own token, so this
# role must also carry Keycloak's user and role administration rights (realm-management:
# manage-users, view-users, query-users, view-realm, manage-realm).
MANAGER_IDENTITY_ADMIN_ROLE=papaia-admin
# Keycloak realm role of the auditors: the only role that sees the inventory of work objects
# (page "Inventory"). Kept apart from the admin role.
MANAGER_AUDITOR_ROLE=papaia-auditor
# Keycloak realm role of the second person who confirms requests for information and erasure
# of a person without an account (page "Data subject requests"). The platform's
# administration role (MANAGER_IDENTITY_ADMIN_ROLE) may confirm as well.
MANAGER_CONFIRM_ROLE=papaia-confirm
# Public base URL (used as OIDC redirect URI base and in CSRF/cookie settings)
MANAGER_HOST=http://localhost:8120
# Keycloak client ID registered in the papaia realm
MANAGER_OIDC_CLIENT_ID=papaia-manager
# Keycloak client secret
MANAGER_OIDC_CLIENT_SECRET=CHANGE_ME
# itsdangerous session signing key (use GENERATE_MANAGER_SESSION_SECRET convention)
MANAGER_SESSION_SECRET=GENERATE_MANAGER_SESSION_SECRET

# --- Language ---
# Language of the interface for an account that has not chosen one and whose browser asks for
# none that is shipped: a directory under src/app/locale (today de), or en. Anything else means
# en. Each account picks its own language in the account menu; that choice is kept on the server
# and follows the account to every computer.
# MANAGER_DEFAULT_LOCALE=en

# --- Language and appearance on a platform with Mein Bereich ---
# Where the manager reaches the platform's preference service (core profile `me`). It is asked
# only while the platform catalog lists Mein Bereich; it then holds the language and the
# appearance of every module. No credential: calls carry the signed-in account's own token.
# PREFS_URL=http://prefs:8080
# Domain the shared cookie `pk_ui` is set for after a change, so the other modules below it see
# the change on their next page. Unset: the manager's own host only.
# PREFS_COOKIE_DOMAIN=papaia.example.org

# --- Paths ---
# Both paths MUST equal their host-side values when the manager runs in Docker.
PAPAIA_CONFIG_DIR=/srv/papaia/config
PAPAIA_WORKSPACE_DIR=/srv/papaia/workspace

# --- RAG system (optional) ---
# Where the manager itself reaches the RAG system's Qdrant. The default resolves on the
# network the manager shares with it. For local development outside Docker, point it at
# a published Qdrant, for example http://localhost:6333. It replaces the address of the
# connection to the integrated Qdrant when the manager connects, and is never written to
# the connection store, which the ingester reads: the ingester always uses
# http://qdrant:6333.
# The api-keys and the connections are not set here: they live in the ingester's store
# (ai/rag/catalog/connections.yaml), and the secrets and the collection and role names
# are read at request time from $PAPAIA_CONFIG_DIR/ai/rag/.env.
# QDRANT_URL=http://qdrant:6333
# Where the manager reaches the ingester's REST API, on the same network. For local
# development outside Docker, point it at a published port, for example
# http://localhost:8300. It is not the ingester's public URL. The token it needs
# (QI_API_TOKEN) is read at request time from $PAPAIA_CONFIG_DIR/ai/rag/.env.
# QDRANT_INGEST_URL=http://qdrant-ingest:8300
# The Embedding page's upload area. An upload that was not embedded successfully is deleted
# after this many hours; the sizes are in MiB, per file and per upload.
# INGEST_UPLOAD_TTL_HOURS=24
# INGEST_MAX_UPLOAD_MB=200
# INGEST_MAX_BATCH_MB=2048
# Where the manager reaches LiteLLM's HTTP API, on the same network, for the Models & Usage
# page. For local development outside Docker, point it at a published port, for example
# http://localhost:4000. The page only reads. The master key it needs (LITELLM_MASTER_KEY)
# is read at request time from $PAPAIA_CONFIG_DIR/ai/litellm/.env, and the link to LiteLLM's
# own Admin UI is built from LITELLM_PUBLIC_URL in $PAPAIA_CONFIG_DIR/.env.
# LITELLM_URL=http://litellm:4000
# Where the manager reaches the admin API of the knowledge-map server, on the same network,
# for the AI map page. Its bearer (KM_ADMIN_TOKEN) is read at request time from
# $PAPAIA_CONFIG_DIR/ai/knowledge-map/.env. The rendered map itself is read from disk.
# KNOWLEDGE_MAP_URL=http://knowledge-map-mcp:8200

# --- TLS (optional) ---
# Uncomment to trust a custom CA (e.g. for internal Docker DNS with self-signed certs)
# SSL_CERT_FILE=/certs/local-ca.crt

# --- Audit rows (papaia.audit/1) ---
# Every write of the manager is also recorded as one row in a SQLite outbox and delivered
# to the core's papaia-audit over mutual TLS. Without the three certificate files below the
# rows wait in the outbox. The outbox defaults to $PAPAIA_CONFIG_DIR/manager/audit/outbox.sqlite3.
# AUDIT_OUTBOX_PATH=/var/lib/papaia-manager/audit/outbox.sqlite3
# AUDIT_INGEST_URL=https://papaia-audit:8443/v1/ingest
# AUDIT_TLS_CA_FILE=/run/papaia/audit-tls/ca.pem
# AUDIT_TLS_CERT_FILE=/run/papaia/audit-tls/client.pem
# AUDIT_TLS_KEY_FILE=/run/papaia/audit-tls/client.key
# The read API of papaia-audit for the page "Data subject requests" (same certificate).
# AUDIT_READ_URL=https://papaia-audit:8443

# --- Inventory of work objects ---
# Where the manager reaches each module's GET /internal/inventory, with the client
# certificate above (mutual TLS). module=https-origin pairs, comma-separated; modules:
# studio, flow, data, assist. An installed module without an address is listed as not
# reachable.
# INVENTORY_SOURCES=studio=https://papaia-studio:8443,flow=https://papaia-flow:8443

# --- Logging ---
LOG_LEVEL=INFO
