# papaia-manager — environment variables.
# Copy to src/.env for local development (never commit the copy).

# --- OIDC (Keycloak) ---
# Browser-facing authorization endpoint
OIDC_ISSUER_KC_AUTH=https://keycloak.example.com/realms/papaia/protocol/openid-connect/auth
# Server-side token endpoint (use internal Docker DNS in container)
OIDC_ISSUER_KC_TOKEN=http://keycloak:8080/realms/papaia/protocol/openid-connect/token
# JWKS endpoint for id_token signature verification
OIDC_ISSUER_KC_CERTS=http://keycloak:8080/realms/papaia/protocol/openid-connect/certs
# Claim name that carries the user's roles (default: roles)
OIDC_ROLE_CLAIM=roles
# Auth provider type: internal_keycloak | external_oidc
AUTH_PROVIDER=internal_keycloak

# --- papaia-manager application ---
# Keycloak realm role granting full access (add-ons, catalogs, jobs, dashboard)
MANAGER_ADMIN_ROLE=manager-admin
# Keycloak realm role granting dashboard-only access. Admins have it implicitly.
MANAGER_USER_ROLE=user
# Keycloak realm role that may manage the users and roles of the realm (the Users page).
# The manager calls Keycloak's Admin API with the signed-in user's own token, so this
# role must also carry Keycloak's user-administration rights (realm-management:
# manage-users, view-users, query-users, view-realm).
MANAGER_IDENTITY_ADMIN_ROLE=papaia-admin
# Public base URL (used as OIDC redirect URI base and in CSRF/cookie settings)
MANAGER_HOST=http://localhost:8120
# Keycloak client ID registered in the papaia realm
MANAGER_OIDC_CLIENT_ID=papaia-manager
# Keycloak client secret
MANAGER_OIDC_CLIENT_SECRET=CHANGE_ME
# itsdangerous session signing key (use GENERATE_MANAGER_SESSION_SECRET convention)
MANAGER_SESSION_SECRET=GENERATE_MANAGER_SESSION_SECRET

# --- Paths ---
# Both paths MUST equal their host-side values when the manager runs in Docker.
PAPAIA_CONFIG_DIR=/srv/papaia/config
PAPAIA_WORKSPACE_DIR=/srv/papaia/workspace

# --- RAG system (optional) ---
# Where the manager itself reaches the RAG system's Qdrant. The default resolves on the
# network the manager shares with it. For local development outside Docker, point it at
# a published Qdrant, for example http://localhost:6333. It replaces the address of the
# connection to the integrated Qdrant when the manager connects, and is never written to
# the connection store, which the ingester reads: the ingester always uses
# http://qdrant:6333.
# The api-keys and the connections are not set here: they live in the ingester's store
# (ai/rag/catalog/connections.yaml), and the secrets and the collection and role names
# are read at request time from $PAPAIA_CONFIG_DIR/ai/rag/.env.
# QDRANT_URL=http://qdrant:6333
# Where the manager reaches the ingester's REST API, on the same network. For local
# development outside Docker, point it at a published port, for example
# http://localhost:8300. It is not the ingester's public URL. The token it needs
# (QI_API_TOKEN) is read at request time from $PAPAIA_CONFIG_DIR/ai/rag/.env.
# QDRANT_INGEST_URL=http://qdrant-ingest:8300
# The Embedding page's upload area. An upload that was not embedded successfully is deleted
# after this many hours; the sizes are in MiB, per file and per upload.
# INGEST_UPLOAD_TTL_HOURS=24
# INGEST_MAX_UPLOAD_MB=200
# INGEST_MAX_BATCH_MB=2048

# --- TLS (optional) ---
# Uncomment to trust a custom CA (e.g. for internal Docker DNS with self-signed certs)
# SSL_CERT_FILE=/certs/local-ca.crt

# --- Logging ---
LOG_LEVEL=INFO
