# Keep the Docker build context minimal — the image only needs src/.

# VCS, CI and Docker config
.git
.gitattributes
.github
.dockerignore

# Tests and documentation are not part of the server image; the page list of the content
# security policy is (app/csp.py).
tests
!tests/csp_baseline.json
*.md

# Exclude docker/ orchestration files, but keep files the Dockerfile COPYs.
docker
!docker/entrypoint.sh
!docker/git-askpass.sh
!docker/verify-sha256.sh
!docker/tailwind.config.js
!docker/tailwind.brand.css
!docker/tailwind.app.css

# The npm package of the kit's browser tools serves the design check only.
src/vendor/papaia-kit/js

# Python / uv artifacts
**/.venv
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.python-version

# Secrets and local config
**/.env
**/.env.local
*.pem
*.key

# Editor / OS
.vscode
.idea
.DS_Store
Thumbs.db
